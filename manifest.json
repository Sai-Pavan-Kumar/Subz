{
  "manifest_version": 3,
  "name": "Subz — Learn English from Subtitles",
  "version": "1.0.0",
  "description": "Master English while watching videos. Subz highlights uncommon words in subtitles with instant definitions, pronunciation, and notes.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://api.dictionaryapi.dev/*",
    "https://api.datamuse.com/*",
    "https://en.wiktionary.org/*"
  ],
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "css": [
        "src/content/content.css"
      ],
      "js": [
        "src/data/common_words.js",
        "src/data/vocab_core.js",
        "src/data/lemmatizer.js",
        "src/data/dictionary_api.js",
        "src/content/card_manager.js",
        "src/content/shortcuts.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
